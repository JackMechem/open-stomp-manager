<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Open Stomp Manager connects to the pedal over Bluetooth when its Wireless setting is on.</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
</dict>
</plist>
