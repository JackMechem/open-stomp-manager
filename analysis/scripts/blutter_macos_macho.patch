diff --git a/blutter/src/ElfHelper.cpp b/blutter/src/ElfHelper.cpp
index 030c0a2..eb8d710 100644
--- a/blutter/src/ElfHelper.cpp
+++ b/blutter/src/ElfHelper.cpp
@@ -152,24 +152,34 @@ LibAppInfo ElfHelper::MapLibAppSo(const char* path)
 	void* lib = load_map_file(path);
 	// quick and dirty parsing ELF to get symbol addresses
 	uint8_t* elf = (uint8_t*)(lib);
-#if defined(DART_TARGET_OS_MACOS)
-	// Note: only new dart version getting snapshots from load command
-	// <=2.17, use EXPORT name
-	// <= v2.18,  load from sub SEGMENT_64, named "__CUSTOM" and section named "__dart_app_snap"
-	// >= 2.19, LC_NOTE command is used
-	auto header = (dart::mach_o::mach_header_64*)lib;
-	switch (header->magic) {
-	case dart::mach_o::MH_MAGIC:
-	case dart::mach_o::MH_CIGAM:
-		throw std::invalid_argument("Mach-O: Support only 64 bits");
-	case dart::mach_o::MH_CIGAM_64:
-		throw std::invalid_argument("Mach-O: Expected a host endian header");
-	case dart::mach_o::MH_MAGIC_64:
-		return size >= sizeof(mach_o::mach_header_64);
-	default:
-		throw std::invalid_argument("Mach-O: Invalid magic header");
+	if (*(uint32_t*)elf == 0xfeedfacf) {
+		// Mach-O 64 (thin). Parse LC_SYMTAB (cmd 2). Assumes __TEXT fileoff == vmaddr (true for Flutter App.framework).
+		uint32_t ncmds = *(uint32_t*)(elf + 16);
+		const uint8_t* lc = elf + 32;
+		LibAppInfo info{};
+		info.lib = elf;
+		for (uint32_t i = 0; i < ncmds; i++) {
+			uint32_t cmd = *(uint32_t*)lc, cmdsize = *(uint32_t*)(lc + 4);
+			if (cmd == 2) {
+				uint32_t symoff = *(uint32_t*)(lc + 8), nsyms = *(uint32_t*)(lc + 12), stroff = *(uint32_t*)(lc + 16);
+				for (uint32_t j = 0; j < nsyms; j++) {
+					const uint8_t* nl = elf + symoff + j * 16;
+					const char* name = (const char*)elf + stroff + *(uint32_t*)nl;
+					uint64_t val = *(uint64_t*)(nl + 8);
+					auto eq = [&](const char* k) { return strcmp(name, k) == 0 || (name[0] == '_' && strcmp(name + 1, k) == 0) || (k[0] == '_' && strcmp(name, k + 1) == 0); };
+					if (eq(kVmSnapshotDataAsmSymbol)) info.vm_snapshot_data = elf + val;
+					else if (eq(kVmSnapshotInstructionsAsmSymbol)) info.vm_snapshot_instructions = elf + val;
+					else if (eq(kIsolateSnapshotDataAsmSymbol)) info.isolate_snapshot_data = elf + val;
+					else if (eq(kIsolateSnapshotInstructionsAsmSymbol)) info.isolate_snapshot_instructions = elf + val;
+				}
+			}
+			lc += cmdsize;
+		}
+		if (!info.vm_snapshot_data || !info.vm_snapshot_instructions || !info.isolate_snapshot_data || !info.isolate_snapshot_instructions)
+			throw std::invalid_argument("Mach-O: cannot find snapshot symbols");
+		return info;
 	}
-#else
